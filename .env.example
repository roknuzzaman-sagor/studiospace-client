# Base URL of the Express/MongoDB API server, including /api.
# Local:  http://localhost:5000/api
# Prod:   https://your-backend-domain.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google OAuth client ID. MUST be the same value as GOOGLE_CLIENT_ID on the
# server. Add http://localhost:3000 (and your production domain) to the
# authorized JavaScript origins in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# imgbb API key used by the Add/Edit Studio image upload button.
# Get a free key at https://api.imgbb.com/ — without it you can still paste
# an image URL manually. The uploaded image URL is what gets stored in MongoDB.
NEXT_PUBLIC_IMGBB_API_KEY=
