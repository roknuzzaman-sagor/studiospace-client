# Base URL of the Express/MongoDB API server (separate repo), including /api.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google OAuth client ID used by the "Continue with Google" button.
# Create one at https://console.cloud.google.com/apis/credentials and add the
# client origin (e.g. http://localhost:3000) to the authorized origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# imgbb API key used by the Add/Edit Studio image upload button.
# Get a free key at https://api.imgbb.com/ — without it you can still paste
# an image URL manually.
NEXT_PUBLIC_IMGBB_API_KEY=
