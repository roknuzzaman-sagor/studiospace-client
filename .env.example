# Base URL of the Express/MongoDB server (separate repo).
# Leave EMPTY to run the client in demo mode (seed data + localStorage auth) —
# the UI fully works for review without a backend.
# When set, auth switches to BetterAuth and all CRUD calls hit the API with
# credentials: 'include' so the HTTPOnly JWT cookie travels with each request.
NEXT_PUBLIC_API_URL=

# imgbb API key used by the Add/Edit Studio image upload button.
# Get a free key at https://api.imgbb.com/ — without it you can still paste
# an image URL manually.
NEXT_PUBLIC_IMGBB_API_KEY=
